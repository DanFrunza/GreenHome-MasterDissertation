# JWT — use a long random string in production
JWT_SECRET=your_jwt_secret_change_in_production

# MQTT internal service account (used by mqtt-service to connect to mqtt-cloud)
MQTT_SERVICE_USER=mqtt-service
MQTT_SERVICE_PASSWORD=your_mqtt_service_password

# PostgreSQL
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=mydb
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# MinIO
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
