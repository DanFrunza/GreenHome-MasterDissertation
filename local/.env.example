# Home identification — get this from GreenNest Settings after creating a home
HOME_ID=your_home_id

# Cloud MQTT broker — where your local broker bridges to
# Demo on same machine (Linux): use 172.25.0.1, port 1884 (fixed gateway of local_default network)
# Demo on same machine (Mac/Windows): host.docker.internal, port 1884
# Real deployment: your server hostname, port 1883
MQTT_CLOUD_HOST=greennest.me
MQTT_CLOUD_PORT=1883

# MQTT password from GreenNest Settings → MQTT Configuration for this home
MQTT_PASSWORD=your_mqtt_password_from_settings

# Local MQTT broker — internal Docker service name, do not change
MQTT_LOCAL_HOST=mqtt-local
MQTT_LOCAL_PORT=1883

# Home Assistant
HA_URL=http://homeassistant:8123
HA_TOKEN=your_ha_long_lived_access_token
